{
  "name": "github-repo-upvotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "worker:dev": "cd src/worker && bunx wrangler dev",
    "worker:deploy": "cd src/worker && bunx wrangler deploy",
    "worker:tail": "cd src/worker && bunx wrangler tail"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.0"
  }
}
