{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "separateMultipleMajor": false,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Group all dependencies together",
      "groupName": "all dependencies",
      "groupSlug": "all",
      "matchPackageNames": ["*"],
      "schedule": ["before 3am on Monday", "before 3am on Thursday"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["badge/TypeScript-(?<currentValue>[\\d\\.]+)-"],
      "depNameTemplate": "typescript",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["badge/Vite-(?<currentValue>[\\d\\.]+)-"],
      "depNameTemplate": "vite",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "assignees": ["kaiehrhardt"],
  "reviewers": ["kaiehrhardt"]
}
